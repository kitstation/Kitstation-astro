---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import "../styles/global.css";

const platformLogos = [
  { src: "/icons/facebook.png", alt: "Facebook" },
  { src: "/icons/tiktok.png", alt: "TikTok" },
  { src: "/icons/whatsapp.png", alt: "WhatsApp" },
  { src: "/icons/woocomerce.png", alt: "WooCommerce" },
  { src: "/icons/wordpress.png", alt: "WordPress" }
];

const features = [
  {
    title: "Bandeja unificada",
    text: "Centraliza WhatsApp, Instagram y otros puntos de contacto sin perder contexto."
  },
  {
    title: "Visibilidad del equipo",
    text: "Supervisa agentes, conversaciones activas y ventas cerradas desde el tablero."
  },
  {
    title: "Analitica clara",
    text: "Mide conversion, volumen por canal e insights del periodo en segundos."
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "LinkStation",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD"
  },
  description:
    "LinkStation centraliza conversaciones, agentes y ventas en un CRM visual para equipos comerciales."
};
---

<BaseLayout
  title="LinkStation | CRM para centralizar conversaciones y ventas"
  description="LinkStation es una landing para presentar un CRM visual que organiza conversaciones, equipo y conversiones desde un solo tablero."
  image="/images/linkstation-crm.png"
  imageAlt="Vista del dashboard de LinkStation CRM"
  structuredData={structuredData}
>
  <main class="linkstation-page">
    <section class="hero linkstation-hero" id="app-movil">
      <div class="linkstation-hero__background" aria-hidden="true"></div>
      <header class="linkstation-nav">
        <div class="container linkstation-nav__shell">
          <a class="linkstation-nav__brand" href="/link-station/" aria-label="Ir al inicio de LinkStation">
            <img
              src="/images/LOGO-CRM@300x.png"
              alt="LinkStation"
              width="300"
              height="72"
              loading="eager"
              decoding="async"
            />
          </a>

          <nav class="linkstation-nav__menu" aria-label="Principal de LinkStation">
            <a href="#app-movil">App Movil</a>
            <a href="#integraciones">Integraciones</a>
            <a href="#agente-kit">AgenteKIT</a>
            <a href="#precios">Precios</a>
            <a href="#como-funciona">¿Como funciona?</a>
          </nav>

          <a class="linkstation-nav__cta" href="/contactanos/">Iniciar sesion</a>
        </div>
      </header>
      <div class="container linkstation-hero__inner">
        <div class="linkstation-copy reveal reveal-up" data-reveal="up">
          <h1 aria-label="Centraliza tus ventas y responde 10x mas rapido">
            <span>Centraliza tus ventas y</span>
            <span>responde <span class="linkstation-count" data-linkstation-count aria-hidden="true">10</span>x mas rapido</span>
          </h1>
          <p>
            Un sistema que organiza a tu equipo, automatiza respuestas con IA y evita que
            pierdas clientes por demorar en responder. Nosotros nos encargamos de toda la
            integracion tecnica.
          </p>

          <div class="linkstation-actions">
            <a class="linkstation-button linkstation-button--ghost" href="#overview">
              Habla con Ventas
            </a>
            <a class="linkstation-button linkstation-button--primary" href="/contactanos/">
              Agendar Demostracion Gratuita
            </a>
          </div>
        </div>

        <div class="linkstation-stage reveal reveal-up" data-reveal="up" id="overview">
          <figure class="linkstation-shot">
            <img
              src="/images/linkstation-crm.png"
              alt="Dashboard principal de LinkStation CRM"
              width="1912"
              height="913"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="linkstation-metrics" id="integraciones">
      <div class="container linkstation-platforms">
        <h2 class="reveal reveal-up" data-reveal="up">Conecta todas tus plataformas a un solo lugar</h2>
        <div class="linkstation-platforms__marquee" aria-label="Plataformas compatibles">
          <div class="linkstation-platforms__track">
            {[...platformLogos, ...platformLogos].map((logo) => (
              <div class="linkstation-platforms__item">
                <img src={logo.src} alt={logo.alt} width="220" height="72" loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
        </div>
        <a class="linkstation-integrations-button" href="#agente-kit">
          Conoce mas sobre nuestras integraciones
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8m15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0M4.5 7.5a.5.5 0 0 0 0 1h5.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5z"/>
          </svg>
        </a>
      </div>
    </section>

    <section class="linkstation-overview" id="agente-kit">
      <div class="container linkstation-problem__grid">
        <div class="linkstation-problem__media reveal reveal-left" data-reveal="left">
          <p>Video animado de todas las redes sociales fusionandose en linkstation.</p>
        </div>

        <div class="linkstation-problem__copy reveal reveal-right" data-reveal="right">
          <h2>¿Tus vendedores pierden mensajes saltando de app en app?</h2>
          <p>
            Mensajes perdidos, tiempos de respuesta lentos, sin control de metricas,
            dependencia de respuestas manuales repetitivas.
          </p>
          <p>Pierdes dinero frente a competidores mas rapidos.</p>
        </div>
      </div>
    </section>

    <section class="linkstation-solution" id="como-funciona">
      <div class="container linkstation-solution__inner">
        <h2 class="reveal reveal-up" data-reveal="up">
          Esta es plataforma que pondra fin a tus mensajes perdidos ¿Como?
        </h2>

        <div class="linkstation-solution__grid">
          <div class="linkstation-solution__list reveal reveal-left" data-reveal="left">
            <article class="linkstation-solution__item is-active">
              <h3>Control Total (Bandeja Unica)</h3>
              <p>
                Deja de perder clientes porque un vendedor olvido revisar el Instagram o
                el TikTok. Centralizamos WhatsApp, Meta, LinkedIn y tu sitio web en un
                solo flujo de trabajo. Si te escriben por donde sea, lo respondes desde
                el mismo lugar, sin friccion y sin cambiar de pestana.
              </p>
            </article>
            <article class="linkstation-solution__item">
              <h3>Automatizacion Inteligente</h3>
            </article>
            <article class="linkstation-solution__item">
              <h3>Asignacion y Colaboracion</h3>
            </article>
            <article class="linkstation-solution__item">
              <h3>Supervision y Metricas</h3>
            </article>
            <article class="linkstation-solution__item">
              <h3>Cero Friccion Tecnica</h3>
            </article>
          </div>

          <div class="linkstation-solution__media reveal reveal-right" data-reveal="right">
            <p>Imagenes describiendo cada una de las cualidades</p>
          </div>
        </div>

        <div class="linkstation-solution__progress" aria-hidden="true">
          <span></span>
        </div>
      </div>
    </section>

    <section class="linkstation-velocity" aria-label="Diseñado por vendedores para vendedores">
      <div class="linkstation-velocity__viewport">
        <div class="linkstation-velocity__track" data-linkstation-velocity-track>
          {Array.from({ length: 8 }).map(() => (
            <span>Diseñado por vendedores para vendedores.</span>
          ))}
        </div>
      </div>
    </section>

    <section class="linkstation-cta" id="precios">
      <div class="container">
        <div class="linkstation-cta__panel reveal reveal-up" data-reveal="up">
          <h2>
            <span>Convierte conversaciones en seguimiento,</span>
            <span>equipo y ventas visibles.</span>
          </h2>
          <a class="linkstation-button linkstation-button--light" href="/contactanos/">
            Quiero una demo
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</BaseLayout>

<script>
  const countNode = document.querySelector("[data-linkstation-count]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (countNode && !reducedMotion.matches) {
    const maxCount = 10;
    let current = 1;

    const animateCount = () => {
      countNode.classList.remove("is-pulsing");
      countNode.textContent = String(current);

      if (current < maxCount) {
        current += 1;
        window.setTimeout(animateCount, 130);
        return;
      }

      countNode.classList.add("is-pulsing");
      current = 1;
      window.setTimeout(animateCount, 820);
    };

    animateCount();
  }

  const velocityTrack = document.querySelector("[data-linkstation-velocity-track]");

  if (velocityTrack && !reducedMotion.matches) {
    let lastScrollY = window.scrollY;
    let currentX = 0;
    let speed = 1.8;
    let targetBoost = 0;
    let currentBoost = 0;
    let lastTime = performance.now();

    window.addEventListener(
      "scroll",
      () => {
        const delta = window.scrollY - lastScrollY;
        lastScrollY = window.scrollY;
        targetBoost = Math.max(-3.8, Math.min(3.8, delta * 0.09));
      },
      { passive: true }
    );

    const moveVelocityText = (time) => {
      const deltaTime = Math.min(time - lastTime, 40);
      lastTime = time;
      currentBoost += (targetBoost - currentBoost) * 0.08;
      targetBoost *= 0.92;
      currentX -= (speed + currentBoost) * (deltaTime / 16.67);

      const firstItem = velocityTrack.querySelector("span");
      const itemWidth = firstItem instanceof HTMLElement ? firstItem.offsetWidth : 0;
      const wrapWidth = itemWidth ? itemWidth * 4 : 1200;

      if (currentX <= -wrapWidth) currentX += wrapWidth;
      if (currentX > 0) currentX -= wrapWidth;

      velocityTrack.style.transform = `translate3d(${currentX}px, 0, 0)`;
      requestAnimationFrame(moveVelocityText);
    };

    requestAnimationFrame(moveVelocityText);
  }
</script>

<style is:global>
  :root {
    --ls-surface: rgba(255, 255, 255, 0.88);
    --ls-surface-strong: rgba(255, 255, 255, 0.96);
    --ls-line: rgba(19, 19, 19, 0.08);
    --ls-text: #202125;
    --ls-soft: #5f6674;
    --ls-blue: #1b70ff;
    --ls-accent: #4fd46f;
    --ls-accent-dark: #1b70ff;
    --ls-shadow: 0 24px 70px rgba(5, 14, 35, 0.12);
  }

  .linkstation-page {
    background: linear-gradient(180deg, #ffffff 0%, #f7f9ff 100%);
    color: var(--ls-text);
  }

  .linkstation-nav {
    position: absolute;
    top: 18px;
    left: 0;
    right: 0;
    z-index: 40;
    padding: 0;
    pointer-events: none;
    background: transparent;
  }

  .linkstation-nav__shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-height: 62px;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.035)),
      rgba(9, 10, 17, 0.54);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 18px 46px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    pointer-events: auto;
  }

  .linkstation-nav__brand {
    display: inline-flex;
    align-items: center;
    color: #ffffff;
    text-decoration: none;
    line-height: 1;
  }

  .linkstation-nav__brand img {
    display: block;
    width: 132px;
    height: auto;
  }

  .linkstation-nav__menu {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(18px, 2.4vw, 34px);
    flex: 1;
  }

  .linkstation-nav__menu a {
    display: inline-flex;
    align-items: center;
    color: #ffffff;
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .linkstation-nav__menu a:hover {
    color: rgba(255, 255, 255, 0.82);
  }

  .linkstation-nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 11px;
    background: var(--ls-blue);
    color: #ffffff;
    font-size: 0.98rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 10px 28px rgba(27, 112, 255, 0.28);
  }

  .linkstation-hero {
    position: relative;
    overflow: hidden;
    min-height: auto;
    padding: 150px 0 40px;
    background:
      radial-gradient(circle at 50% 0%, rgba(82, 39, 255, 0.18), transparent 34%),
      linear-gradient(180deg, #02030a 0%, #05080b 48%, #08050d 78%, #000000 100%);
  }

  .linkstation-hero::before {
    content: none;
  }

  .linkstation-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(1, 2, 8, 0.12), rgba(1, 2, 8, 0.22) 56%, rgba(0, 0, 0, 0.7) 100%),
      radial-gradient(circle at 50% 36%, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.42) 74%);
    pointer-events: none;
    z-index: 1;
  }

  .linkstation-hero__inner {
    position: relative;
    z-index: 2;
  }

  .linkstation-hero__background {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    background:
      linear-gradient(90deg, rgba(82, 39, 255, 0.22), rgba(124, 255, 103, 0.2) 48%, rgba(82, 39, 255, 0.24)),
      linear-gradient(180deg, rgba(1, 2, 8, 0) 0%, rgba(1, 2, 8, 0.22) 45%, rgba(0, 0, 0, 0.96) 100%);
    box-shadow: inset 0 -220px 180px rgba(0, 0, 0, 0.86);
  }

  .linkstation-hero__background::before,
  .linkstation-hero__background::after {
    content: "";
    position: absolute;
    inset: -16% -10%;
    pointer-events: none;
    opacity: 0.72;
    transform-origin: center;
  }

  .linkstation-hero__background::before {
    background:
      radial-gradient(50% 68% at 17% 22%, rgba(82, 39, 255, 0.42), transparent 74%),
      radial-gradient(38% 58% at 50% 20%, rgba(124, 255, 103, 0.34), transparent 76%),
      radial-gradient(48% 66% at 84% 20%, rgba(82, 39, 255, 0.46), transparent 78%);
    filter: blur(46px);
  }

  .linkstation-hero__background::after {
    inset: -30% -58% -24%;
    background:
      radial-gradient(38% 46% at 18% 36%, rgba(124, 255, 103, 0.28), transparent 72%),
      radial-gradient(36% 48% at 82% 30%, rgba(82, 39, 255, 0.36), transparent 72%),
      linear-gradient(
        100deg,
        transparent 12%,
        rgba(82, 39, 255, 0.08) 22%,
        rgba(82, 39, 255, 0.3) 34%,
        rgba(124, 255, 103, 0.32) 50%,
        rgba(82, 39, 255, 0.34) 66%,
        rgba(82, 39, 255, 0.08) 78%,
        transparent 88%
      );
    filter: blur(46px);
  }

  .linkstation-copy {
    max-width: 880px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .linkstation-badge,
  .linkstation-sectionhead span {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 16px;
    border: 1px solid rgba(19, 19, 19, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    color: #3d4655;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .linkstation-copy h1,
  .linkstation-sectionhead h2,
  .linkstation-cta__panel h2 {
    margin: 20px 0 0;
    font-size: clamp(2.5rem, 4.8vw, 4.2rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .linkstation-copy h1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: fit-content;
    margin-inline: auto;
    color: #ffffff;
    font-weight: 500;
    text-shadow: 0 16px 50px rgba(0, 0, 0, 0.35);
  }

  .linkstation-copy h1 span {
    display: block;
    white-space: nowrap;
    color: #ffffff;
    font-weight: 500;
  }

  .linkstation-copy h1 > span {
    background-image: linear-gradient(110deg, #f4f7ff 0%, #f4f7ff 36%, #ffffff 50%, #dce7ff 62%, #f4f7ff 100%);
    background-size: 220% auto;
    background-position: 140% center;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: linkstationShinyText 3.6s ease-in-out infinite;
  }

  .linkstation-copy h1 .linkstation-count {
    display: inline-block;
    min-width: 1.16em;
    text-align: right;
    transform-origin: center;
    color: #ffffff;
    -webkit-text-fill-color: #ffffff;
  }

  .linkstation-copy h1 .linkstation-count.is-pulsing {
    animation: linkstationCountPulse 0.58s ease-out;
  }

  .linkstation-copy h1 span + span {
    margin-top: 0.02em;
  }

  .linkstation-copy p,
  .linkstation-sectionhead p {
    max-width: 760px;
    margin: 22px auto 0;
    color: #4f5665;
    font-size: clamp(0.92rem, 1.35vw, 1.08rem);
    line-height: 1.55;
  }

  .linkstation-copy p {
    max-width: 960px;
    color: #ffffff;
  }

  .linkstation-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .linkstation-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 500;
    isolation: isolate;
    overflow: hidden;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .linkstation-button:hover {
    transform: translateY(-2px);
  }

  .linkstation-button--primary {
    background: var(--ls-blue);
    color: #fff;
    box-shadow: 0 18px 42px rgba(27, 112, 255, 0.24);
  }

  .linkstation-button--primary::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    padding: 1px;
    background:
      linear-gradient(
        110deg,
        rgba(255, 255, 255, 0.26) 0%,
        rgba(255, 255, 255, 0.26) 32%,
        rgba(255, 255, 255, 1) 48%,
        rgba(183, 216, 255, 0.58) 64%,
        rgba(255, 255, 255, 0.26) 100%
      );
    background-size: 240% 100%;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.95;
    animation: linkstationSpecularSweep 3.2s ease-in-out infinite;
    pointer-events: none;
  }

  .linkstation-button--primary:hover::before {
    animation-duration: 1.8s;
    opacity: 1;
  }

  .linkstation-button--ghost {
    border-color: transparent;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.035)),
      rgba(255, 255, 255, 0.025);
    color: #ffffff;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.26),
      0 16px 36px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(14px) saturate(145%);
    -webkit-backdrop-filter: blur(14px) saturate(145%);
  }

  .linkstation-button--ghost::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    padding: 1px;
    background:
      linear-gradient(
        110deg,
        rgba(255, 255, 255, 0.24) 0%,
        rgba(255, 255, 255, 0.24) 32%,
        rgba(255, 255, 255, 1) 48%,
        rgba(255, 255, 255, 0.34) 64%,
        rgba(255, 255, 255, 0.24) 100%
      );
    background-size: 240% 100%;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 1;
    animation: linkstationSpecularSweep 3.2s ease-in-out infinite;
    pointer-events: none;
  }

  .linkstation-button--ghost::after {
    content: "";
    position: absolute;
    inset: 1px;
    z-index: -1;
    border-radius: calc(12px - 1px);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.015));
    pointer-events: none;
  }

  .linkstation-button--ghost:hover {
    border-color: rgba(255, 255, 255, 0.48);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.06)),
      rgba(255, 255, 255, 0.04);
    color: #ffffff;
  }

  .linkstation-button--ghost:hover::before {
    opacity: 1;
    animation-duration: 1.8s;
  }

  .linkstation-button--light {
    background: #fff;
    color: var(--ls-blue);
  }

  .linkstation-stage {
    position: relative;
    margin-top: 56px;
    padding: 34px 0 24px;
    z-index: 2;
  }

  .linkstation-shot {
    position: relative;
    z-index: 1;
    width: min(1180px, 100%);
    margin: 0 auto;
    border: 1px solid rgba(19, 19, 19, 0.08);
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: var(--ls-shadow);
    transform: translateZ(0);
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  .linkstation-shot:hover {
    transform: scale(1.025);
    box-shadow: 0 30px 88px rgba(5, 14, 35, 0.18);
  }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .linkstation-hero__background::before {
      animation: linkstationAuroraDriftA 22s ease-in-out infinite alternate;
      will-change: transform, opacity;
    }

    .linkstation-hero__background::after {
      animation: linkstationAuroraWave 9s ease-in-out infinite;
      will-change: transform, opacity;
    }
  }

  .linkstation-shot::after {
    content: "";
    position: absolute;
    right: 0;
