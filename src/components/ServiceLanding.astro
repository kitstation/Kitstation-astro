---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import "../styles/global.css";

interface Props {
  pageTitle: string;
  metaDescription: string;
  title: string;
  titleHtml?: string;
  subtitle?: string;
  accent: string;
  panelColor: string;
  videoSrc?: string;
  videoFit?: string;
  videoPadding?: string;
  contentWidth?: string;
  titleWidth?: string;
  titleSize?: string;
  titleMobileSize?: string;
  contentAlign?: string;
  formName?: string;
}

const {
  pageTitle,
  metaDescription,
  title,
  titleHtml = "",
  subtitle = "",
  accent,
  panelColor,
  videoSrc = "",
  videoFit = "cover",
  videoPadding = "0",
  contentWidth = "560px",
  titleWidth = "100%",
  titleSize = "clamp(1.9rem, 2.7vw, 2.9rem)",
  titleMobileSize = "clamp(1.8rem, 8vw, 2.45rem)",
  contentAlign = "center",
  formName = title
} = Astro.props;
---

<BaseLayout title={pageTitle} description={metaDescription}>
  <main
    class="service-form-page"
    style={`--service-accent:${accent}; --service-panel:${panelColor}; --service-video-fit:${videoFit}; --service-video-padding:${videoPadding};`}
  >
    <section class="service-form-page__split">
      <div class="service-form-page__left">
        <div
          class="service-form-page__content"
          style={`--service-content-width:${contentWidth}; --service-title-size:${titleSize}; --service-title-mobile-size:${titleMobileSize}; --service-content-align:${contentAlign};`}
        >
          {titleHtml ? <h1 style={`--service-title-width:${titleWidth};`} set:html={titleHtml}></h1> : <h1 style={`--service-title-width:${titleWidth};`}>{title}</h1>}
          {subtitle && <p class="service-form-page__subtitle">{subtitle}</p>}

          <form class="service-form-page__form" method="POST" action="/api/enviar-formulario" data-mail-form>
            <input type="hidden" name="formulario" value={formName} />
            <input type="hidden" name="pagina_origen" value="" />
            <input class="form-honeypot" type="text" name="website" autocomplete="off" tabindex="-1" aria-hidden="true" />
            <input type="text" name="company" placeholder="Nombre de empresa" required />
            <input type="email" name="email" placeholder="Correo" required />
            <input type="tel" name="phone" placeholder="Celular" required />
            <textarea name="message" placeholder="Mensaje" required></textarea>
            <button type="submit">ENVIAR</button>
            <p class="form-feedback" role="status" aria-live="polite"></p>
          </form>

          <p class="service-form-page__privacy">
            Al avanzar, aceptas la <a href="/politicas-y-privacidad/">Política de privacidad</a>
          </p>
        </div>
      </div>

      <div class="service-form-page__right">
        <div class="service-form-page__video-slot" aria-hidden={videoSrc ? undefined : "true"}>
          {videoSrc && (
            <video class="service-form-page__video" autoplay muted playsinline loop preload="metadata">
              <source src={videoSrc} type="video/mp4" />
            </video>
          )}
        </div>
      </div>
    </section>
  </main>
  <WhatsAppButton />
</BaseLayout>

<style>
  .service-form-page {
    min-height: 100vh;
    background: #000;
  }

  .service-form-page__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
  }

  .service-form-page__left {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 48px 72px;
    background: #000;
  }

  .service-form-page__content {
    width: min(100%, var(--service-content-width));
    text-align: var(--service-content-align);
  }

  .service-form-page__content h1 {
    width: min(100%, var(--service-title-width));
    margin: 0;
    margin-inline: auto;
    color: #fff;
    font-size: var(--service-title-size);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.05em;
    text-align: center;
  }

  :global(.service-form-page__title-line) {
    display: block;
    text-align: center;
    white-space: nowrap;
  }

  .service-form-page__subtitle {
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1rem;
    line-height: 1.5;
  }

  .service-form-page__form {
    display: grid;
    gap: 14px;
    margin-top: 28px;
  }

  .service-form-page__form input,
  .service-form-page__form textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    padding: 14px 16px;
  }

  .service-form-page__form textarea {
    min-height: 136px;
    resize: vertical;
  }

  .service-form-page__form button {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 52px;
    border: 0;
    border-radius: 14px;
    background: var(--service-accent);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
  }

  .service-form-page__form button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    padding: 1px;
    background:
      linear-gradient(
        110deg,
        rgba(255, 255, 255, 0.24) 0%,
        rgba(255, 255, 255, 0.24) 32%,
        rgba(255, 255, 255, 1) 48%,
        rgba(183, 216, 255, 0.58) 64%,
        rgba(255, 255, 255, 0.24) 100%
      );
    background-size: 240% 100%;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.95;
    animation: serviceButtonSpecularSweep 3.2s ease-in-out infinite;
    pointer-events: none;
  }

  .service-form-page__form button:hover::before {
    animation-duration: 1.8s;
    opacity: 1;
  }

  .service-form-page__privacy {
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.92rem;
  }

  .service-form-page__privacy a {
    text-decoration: underline;
  }

  .service-form-page__right {
    display: flex;
    align-items: stretch;
    justify-content: center;
    background: var(--service-panel);
  }

  .service-form-page__video-slot {
    width: 100%;
    padding: var(--service-video-padding);
    overflow: hidden;
  }

  .service-form-page__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @keyframes serviceButtonSpecularSweep {
    0%,
    100% {
      background-position: 120% 50%;
    }

    50% {
      background-position: -120% 50%;
    }
  }

  @media (max-width: 960px) {
    .service-form-page__split {
      grid-template-columns: 1fr;
    }

    .service-form-page__left {
      padding: 112px 24px 56px;
    }

    .service-form-page__content h1 {
      font-size: var(--service-title-mobile-size);
    }

    .service-form-page__subtitle {
      font-size: 0.8rem;
      line-height: 1.38;
    }
  }
</style>
