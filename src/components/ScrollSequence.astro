---
// src/components/ScrollSequence.astro
---

<section id="scroll-sequence-section" class="relative w-full h-[48vh] md:h-screen bg-[#EEEEEE] z-10 overflow-hidden">
  <div class="w-full h-full flex flex-col justify-start md:justify-center items-center overflow-hidden relative pt-0 md:pt-0">
    
    <!-- El canvas ajustado verticalmente para no quedar tapado por el header -->
    <canvas id="sequence-canvas" width="960" height="540" class="w-full h-full object-contain md:object-cover scale-[1.35] -translate-y-6 md:translate-y-0 md:scale-100 md:object-center transform origin-center transition-all duration-300"></canvas>

    <!-- Texto flotante mecanografiado en la zona inferior -->
    <div class="absolute bottom-[12%] md:bottom-[6%] left-1/2 -translate-x-1/2 text-center pointer-events-none z-30 px-4 w-full max-w-4xl">
      <p id="typewriter-text" class="text-[#050505] text-base sm:text-lg md:text-[22px] leading-relaxed font-medium md:font-semibold tracking-tight min-h-[2.5em]">
      </p>
    </div>
  </div>
</section>

<script>
  let sequenceInitialized = false;

  const initializeSequence = async () => {
    if (sequenceInitialized) return;
    sequenceInitialized = true;

    // GSAP queda fuera de la ruta crítica y se descarga cuando la sección se acerca.
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import("gsap"),
      import("gsap/ScrollTrigger")
    ]);
    gsap.registerPlugin(ScrollTrigger);

    const canvas = document.getElementById("sequence-canvas") as HTMLCanvasElement;
    const context = canvas ? canvas.getContext("2d") : null;
    const textElement = document.getElementById("typewriter-text");
    if (!canvas || !context) return;

    // Configuración de la secuencia
    const frameCount = 120;
    const useMobileFrames = window.matchMedia("(max-width: 767px)").matches;
    const currentFrame = (index: number) => {
      const frameNumber = String(index).padStart(3, "0");
      return useMobileFrames
        ? `/frames-webp/frame${frameNumber}.webp`
        : `/frames/frame${frameNumber}.jpg`;
    };

    const images: HTMLImageElement[] = [];
    const sequence = { frame: 0 };
    let lastTextChars = -1;

    // El texto completo que queremos tipear
    const fullText = "Tu ecosistema digital en\nun solo lugar.";

    const render = () => {
      const img = images[sequence.frame];
      if (!img || !img.complete || img.naturalWidth === 0) return;

      // Mantener proporciones nativas en el buffer interno del canvas
      if (canvas.width !== img.width || canvas.height !== img.height) {
         canvas.width = img.width;
         canvas.height = img.height;
      }
      
      context.clearRect(0, 0, canvas.width, canvas.height);
      context.drawImage(img, 0, 0);

      // Efecto Typewriter guiado por el scroll
      if (textElement) {
        // Sincronizar el tipear entre los fotogramas 10 y 110 para que sea perfecto
        const startFrame = 10;
        const endFrame = 110;
        const progress = Math.max(0, Math.min(1, (sequence.frame - startFrame) / (endFrame - startFrame)));
        const charsToShow = Math.round(progress * fullText.length);

        // Evitar escrituras repetidas del DOM durante cada actualización de GSAP.
        if (charsToShow === lastTextChars) return;
        lastTextChars = charsToShow;
        const currentText = fullText.slice(0, charsToShow).replace(/\n/g, '<br />');
        
        // Cursor tildante mientras escribe
        const cursor = charsToShow > 0 && charsToShow < fullText.length 
          ? '<span class="inline-block w-[3px] h-[0.8em] bg-blue-600 align-middle ml-1 animate-pulse rounded-full"></span>' 
          : '';

        textElement.innerHTML = currentText + cursor;
      }
    };

    for (let i = 0; i <= frameCount; i++) {
      const img = new Image();
      img.decoding = "async";
      images.push(img);
      
      // Renderizar la primera imagen una vez que cargue
      if (i === 0) {
        img.onload = render;
      }
    }

    images.forEach((img, i) => {
      img.src = currentFrame(i);
    });

    // Configurar la animación con GSAP ScrollTrigger
    gsap.to(sequence, {
      frame: frameCount,
      snap: "frame",
      ease: "none",
      scrollTrigger: {
        trigger: "#scroll-sequence-section",
        start: "top top",
        end: window.innerWidth < 768 ? "+=120%" : "+=200%",
        scrub: 0.5,
        pin: true,
        anticipatePin: 1
      },
      onUpdate: render
    });

    window.addEventListener("resize", render);

    // Limpiar ScrollTrigger en caso of desmontaje (HMR en desarrollo)
    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("resize", render);
      ScrollTrigger.getAll().forEach(t => t.kill());
    });
  };

  const sequenceSection = document.getElementById("scroll-sequence-section");
  if (sequenceSection && "IntersectionObserver" in window) {
    const sequenceObserver = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      sequenceObserver.disconnect();
      void initializeSequence();
    }, { rootMargin: "500px 0px" });
    sequenceObserver.observe(sequenceSection);
  } else {
    void initializeSequence();
  }
</script>

<style is:global>
  .pin-spacer {
    background-color: #EEEEEE !important;
  }
</style>
