---
import Reveal from "./Reveal.astro";
import { servicePages } from "../data/servicePages";

const services = [
  {
    title: "Desarrollo Web y E-commerce",
    titleHtml: "Desarrollo Web y<br />E-commerce",
    href: "/diseno-de-pagina-web/",
    image: "/images/perso/Desarrollo Web y E-commerce.jpg",
    accent: "#6945bb",
    bullets: [
      "Diseño UX/UI y web corporativa",
      "Landing pages y e-commerce",
      "Formularios, pagos y WhatsApp",
      "Optimización de velocidad"
    ]
  },
  {
    title: "Automatización con IA",
    href: "/automatizacion-con-ia/",
    image: "/images/perso/Automatización con IA.jpg",
    accent: "#2c70ff",
    bullets: [
      "Chatbots",
      "WhatsApp",
      "Calificación de leads",
      "Seguimiento automático",
      "Distribución de conversaciones",
      "Automatización comercial"
    ]
  },
  {
    title: "Captación de clientes",
    href: "/campanas-digitales/",
    image: "/images/perso/Captación de clientes.jpeg",
    accent: "#454884",
    bullets: ["Google Ads", "Meta Ads", "TikTok Ads", "SEO", "Analítica", "Seguimiento de conversiones"]
  },
  {
    title: "Software para operaciones",
    href: "/consultoria-y-soporte/",
    image: "/images/perso/Software para operaciones.jpeg",
    accent: "#f4bc22",
    bullets: [
      "Software a medida",
      "Sistemas internos",
      "CRM",
      "Integraciones con APIs",
      "Paneles de gestión",
      "Automatización de operaciones"
    ]
  },
  {
    title: "Marca y contenido digital",
    href: "/creacion-de-contenido/",
    image: "/images/perso/Marca y contenido digital.jpg",
    accent: "#d97852",
    bullets: [
      "Branding",
      "Diseño gráfico",
      "Contenido para campañas",
      "Animación 2D y 3D",
      "Videos",
      "Recursos visuales para webs y redes"
    ]
  }
];
---

<section class="objectives" id="servicios" aria-labelledby="servicios-title">
  <div class="container">
    <Reveal class="objective-copy objective-copy--center" delay={0}>
      <h2 id="servicios-title">Elige tu solución</h2>
    </Reveal>

    <div
      class="service-carousel service-carousel--objective reveal reveal-up"
      data-reveal="up"
      data-carousel
      data-carousel-loop="5"
    >
      <div class="service-carousel__head">
        <div class="service-carousel__controls">
          <button type="button" aria-label="Objetivo anterior" data-carousel-prev>
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path
                fill-rule="evenodd"
                d="M12 8a.5.5 0 0 1-.5.5H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H11.5a.5.5 0 0 1 .5.5"
              />
            </svg>
          </button>
          <button type="button" aria-label="Objetivo siguiente" data-carousel-next>
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path
                fill-rule="evenodd"
                d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8"
              />
            </svg>
          </button>
        </div>
      </div>

      <div class="service-carousel__track service-carousel__track--objective" data-carousel-track>
        {services.map((service, index) => (
          <article
            class={`service-card${service.href.includes("/diseno-de-pagina-web/") ? " service-card--web" : ""}${service.href.includes("/campanas-digitales/") || service.href.includes("/automatizacion-con-ia/") || service.href.includes("/consultoria-y-soporte/") || service.href.includes("/creacion-de-contenido/") ? " service-card--compact" : ""}`}
            style={`--accent:${service.accent}; --bg:url("${service.image}")`}
            data-delay={index * 50}
          >
            <a class="service-card__overlay" href={service.href} aria-label={`Ver ${service.title}`}></a>
            <div class="service-card__content">
              <p class="service-card__label">Servicio recomendado</p>
              {service.titleHtml ? <h3 set:html={service.titleHtml}></h3> : <h3>{service.title}</h3>}
              <ul>
                {service.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
              <span class="service-card__action">Empezar ahora</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .objective-copy__text {
    max-width: 880px;
    margin: 0 auto 22px;
    color: #5f6674;
    text-align: center;
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .objective-copy__text {
      display: none;
    }
  }
</style>
