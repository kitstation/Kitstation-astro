---
// DisenoWebEcommerce.astro
const features = [
  {
    title: 'Tienda online',
    description: 'Vende tus productos y gestiona tu inventario con una plataforma de comercio electrónico segura y fácil de usar.',
    image: '/images/diseno-web/tienda-online.webp'
  },
  {
    title: 'Correos personalizados',
    description: 'Potencia tu identidad corporativa con correos profesionales que generen confianza y autoridad en cada mensaje que envíes.',
    image: '/images/diseno-web/correo-personalizado.webp'
  },
  {
    title: 'Blog profesional',
    description: 'Comparte contenido de valor, mejora tu posicionamiento en buscadores y conecta con tu audiencia de manera estratégica y constante.',
    image: '/images/diseno-web/blog-profesional.webp'
  },
  {
    title: 'Software para agendar citas',
    description: 'Automatiza tus reservas y organiza tu calendario con un sistema interactivo diseñado para optimizar el tiempo de tu negocio.',
    image: '/images/diseno-web/citas-agendar.webp'
  }
];
---
<section class="bg-white text-black py-24 overflow-hidden">
  <!-- Marquee -->
  <div class="w-full flex whitespace-nowrap overflow-hidden mb-20 py-6">
    <div class="animate-marquee inline-block" style="animation-duration: 60s;">
      {[...Array(6)].map((_) => (
        <span class="text-4xl md:text-6xl font-bold px-3">
          Más resultados para tus proyectos. 🔥
        </span>
      ))}
    </div>
    <!-- Duplicate for seamless loop -->
    <div class="animate-marquee inline-block" aria-hidden="true" style="animation-duration: 60s;">
      {[...Array(6)].map((_) => (
        <span class="text-4xl md:text-6xl font-bold px-3">
          Más resultados para tus proyectos. 🔥
        </span>
      ))}
    </div>
  </div>

  <div class="w-full max-w-7xl mx-auto px-6 flex flex-col items-center">
    <div class="text-center max-w-4xl mb-16 mx-auto">
      <h2 class="text-2xl leading-[1.3] md:text-4xl md:leading-[1.3] lg:text-[45px] lg:leading-[1.3] font-bold mb-6 text-balance mx-auto">
        Todo lo que tu negocio necesita para vender en digital
      </h2>
      <p class="text-gray-500 text-lg md:text-xl text-balance">
        Infraestructura sólida, diseño estratégico e integraciones listas para escalar tus operaciones.
      </p>
    </div>
    <!-- Products Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full">
      {features.map((feature) => (
        <div class="bg-gray-50 rounded-3xl flex flex-col sm:flex-row overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-100">
          <div class="w-full sm:w-[45%] h-56 sm:h-auto flex-shrink-0 bg-gray-200">
             <img src={feature.image} alt={feature.title} class="w-full h-full object-cover object-center" />
          </div>
          <div class="flex flex-col justify-center p-6 md:p-8 sm:w-[55%] text-center sm:text-left bg-gray-50">
            <h4 class="text-lg md:text-xl font-bold mb-2">{feature.title}</h4>
            <p class="text-gray-500 text-sm leading-relaxed">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
