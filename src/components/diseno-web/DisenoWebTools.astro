---
// DisenoWebTools.astro
---
<section class="w-full relative flex flex-col items-center pt-24 pb-32 px-6 bg-black text-white">
  <div class="w-full max-w-[1000px] text-center mb-16 relative z-20 mx-auto">
    <h2 class="text-2xl leading-[1.3] md:text-4xl md:leading-[1.3] lg:text-[45px] lg:leading-[1.3] font-bold mb-6 tracking-tight w-full text-balance mx-auto max-w-4xl">
      Experiencias interactivas en 3D que elevan tu producto
    </h2>
    <p class="text-gray-400 max-w-3xl mx-auto mb-8 text-base md:text-lg text-balance">
      Haz clic, gira y explora el modelo en tiempo real. Integramos tecnología 3D optimizada para aumentar el tiempo de retención y la conversión.
    </p>
  </div>

  <!-- 3D Viewer Container -->
  <div class="relative w-full max-w-lg h-[500px] md:h-[650px] mx-auto group">
    
    <!-- Background Orange Glow -->
    <div class="absolute inset-0 z-0 flex items-center justify-center pointer-events-none">
      <div class="w-[300px] h-[300px] bg-[#f76d2b]/20 rounded-full blur-[100px] transition-all duration-700"></div>
    </div>

    <!-- Viewer DOM Element -->
    <div id="three-viewer-container" class="w-full h-full relative z-10 cursor-grab active:cursor-grabbing pointer-events-none md:pointer-events-auto"></div>

    <!-- UI Overlay: Loader -->
    <div id="three-loader" class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-black/60 backdrop-blur-md rounded-[3rem] transition-opacity duration-700 pointer-events-none">
      <div class="w-12 h-12 border-4 border-gray-700 border-t-[#f76d2b] rounded-full animate-spin mb-4"></div>
      <span id="three-progress" class="text-white font-bold tracking-widest text-sm">0%</span>
    </div>

    <!-- UI Overlay: Model Selector -->
    <div class="absolute right-2 md:-right-16 top-1/2 -translate-y-1/2 z-30 flex flex-col gap-3">
      <button class="model-select-btn w-11 h-11 md:w-12 md:h-12 rounded-2xl bg-white/20 backdrop-blur-md border border-white/30 flex items-center justify-center hover:bg-white/30 transition-all shadow-lg active:scale-95" data-model="/models/iphone.glb" title="iPhone 17 Pro">
        <i class="bi bi-phone text-white text-lg md:text-xl pointer-events-none"></i>
      </button>
      <button class="model-select-btn w-11 h-11 md:w-12 md:h-12 rounded-2xl bg-white/5 backdrop-blur-md border border-white/10 flex items-center justify-center hover:bg-white/30 transition-all shadow-lg active:scale-95" data-model="/models/airpods_pro_3.glb" title="AirPods Pro 3">
        <i class="bi bi-earbuds text-white text-lg md:text-xl pointer-events-none"></i>
      </button>
    </div>

    <!-- UI Overlay: Mobile 3D Interaction Toggle -->
    <div class="md:hidden absolute bottom-4 left-1/2 -translate-x-1/2 z-30 flex items-center justify-center w-full px-4 pointer-events-auto">
      <button 
        id="btn-mobile-3d-toggle" 
        class="flex items-center gap-2 bg-black/80 backdrop-blur-xl border border-white/20 text-white text-xs font-semibold px-4 py-2.5 rounded-full shadow-2xl transition-all duration-300 active:scale-95"
      >
        <span id="mobile-3d-icon" class="flex items-center justify-center">
          <i class="bi bi-arrows-move text-sm"></i>
        </span>
        <span id="mobile-3d-text">Toca para interactuar en 3D</span>
      </button>
    </div>

    <!-- UI Overlay: Glassmorphism Controls (Desktop) -->
    <div class="hidden md:flex absolute -bottom-12 left-1/2 -translate-x-1/2 z-20 items-center gap-3 bg-white/10 backdrop-blur-xl border border-white/20 rounded-full px-5 py-2.5 shadow-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      <button id="btn-three-play" class="text-white hover:text-[#f76d2b] transition-colors w-8 h-8 flex items-center justify-center" title="Pausar/Reanudar rotación">
        <!-- Default: Pause Icon (Since autoRotate is true) -->
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5zm5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5z"/>
        </svg>
      </button>
      <div class="w-px h-5 bg-white/20"></div>
      <button id="btn-three-reset" class="text-white hover:text-[#f76d2b] transition-colors w-8 h-8 flex items-center justify-center" title="Centrar cámara">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
          <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
        </svg>
      </button>
      <div class="w-px h-5 bg-white/20"></div>
      <span class="text-xs text-white/90 font-medium px-2 pointer-events-none whitespace-nowrap tracking-wide">Arrastra para rotar</span>
    </div>
  </div>
</section>

<script>
  import { ThreeViewer } from '../../utils/ThreeViewer.js';

  let viewerInstance: any = null;

  const initViewer = () => {
    const container = document.getElementById('three-viewer-container');
    if (!container || viewerInstance) return;

    const loaderEl = document.getElementById('three-loader');
    const progressEl = document.getElementById('three-progress');
    const playBtn = document.getElementById('btn-three-play');
    const resetBtn = document.getElementById('btn-three-reset');
    const modelBtns = document.querySelectorAll('.model-select-btn');

    viewerInstance = new ThreeViewer(container, {
      modelPath: '/models/iphone.glb', // Asegúrate de colocar tu modelo aquí en public/models/iphone.glb
      autoRotateSpeed: 1.5,
      onProgress: (xhr: ProgressEvent) => {
        if (xhr.lengthComputable && progressEl) {
          const percentComplete = Math.round((xhr.loaded / xhr.total) * 100);
          progressEl.textContent = `${percentComplete}%`;
        } else if (progressEl) {
          progressEl.textContent = 'Cargando...';
        }
      },
      onLoad: () => {
        if (loaderEl) {
          loaderEl.style.opacity = '0';
          setTimeout(() => {
            loaderEl.style.display = 'none';
          }, 700);
        }
      }
    });

    if (playBtn) {
      playBtn.addEventListener('click', () => {
        if (!viewerInstance) return;
        const isPlaying = viewerInstance.toggleAutoRotate();
        playBtn.innerHTML = isPlaying 
          ? '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5zm5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5z"/></svg>'
          : '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z"/></svg>';
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (viewerInstance) viewerInstance.resetCamera();
      });
    }

    if (modelBtns.length > 0) {
      modelBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const modelPath = btn.getAttribute('data-model');
          if (modelPath && viewerInstance) {
            viewerInstance.loadNewModel(modelPath);
            
            // Update active styling
            modelBtns.forEach(b => {
              b.classList.remove('bg-white/20', 'border-white/30');
              b.classList.add('bg-white/5', 'border-white/10');
            });
            btn.classList.remove('bg-white/5', 'border-white/10');
            btn.classList.add('bg-white/20', 'border-white/30');
          }
        });
      });
    }

    // Mobile 3D Toggle Handler
    const mobileToggleBtn = document.getElementById('btn-mobile-3d-toggle');
    const mobile3dIcon = document.getElementById('mobile-3d-icon');
    const mobile3dText = document.getElementById('mobile-3d-text');
    let isMobileInteractive = false;

    if (mobileToggleBtn) {
      mobileToggleBtn.addEventListener('click', () => {
        if (!viewerInstance) return;
        isMobileInteractive = !isMobileInteractive;
        viewerInstance.setInteractive(isMobileInteractive);

        if (isMobileInteractive) {
          container.classList.remove('pointer-events-none');
          container.classList.add('pointer-events-auto');
          mobileToggleBtn.classList.add('bg-white', 'text-black', 'border-white', 'shadow-[0_0_20px_rgba(255,255,255,0.4)]');
          mobileToggleBtn.classList.remove('bg-black/80', 'text-white', 'border-white/20');
          if (mobile3dIcon) mobile3dIcon.innerHTML = '<i class="bi bi-check2 text-sm font-bold"></i>';
          if (mobile3dText) mobile3dText.textContent = 'Listo (Continuar scroll)';
        } else {
          container.classList.remove('pointer-events-auto');
          container.classList.add('pointer-events-none');
          mobileToggleBtn.classList.remove('bg-white', 'text-black', 'border-white', 'shadow-[0_0_20px_rgba(255,255,255,0.4)]');
          mobileToggleBtn.classList.add('bg-black/80', 'text-white', 'border-white/20');
          if (mobile3dIcon) mobile3dIcon.innerHTML = '<i class="bi bi-arrows-move text-sm"></i>';
          if (mobile3dText) mobile3dText.textContent = 'Toca para interactuar en 3D';
        }
      });
    }
  };

  initViewer();
  document.addEventListener('astro:page-load', initViewer);
  
  document.addEventListener('astro:before-swap', () => {
    if (viewerInstance) {
      viewerInstance.dispose();
      viewerInstance = null;
    }
  });
</script>
