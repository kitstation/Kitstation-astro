---
// DisenoWebFeatures.astro
---
<section class="bg-black text-white py-24 px-6 flex flex-col items-center justify-center overflow-hidden">
  <div class="w-full max-w-4xl flex flex-col items-center text-center">
    <h2 class="text-2xl leading-[1.3] md:text-4xl md:leading-[1.3] lg:text-[45px] lg:leading-[1.3] font-bold mb-6 text-balance mx-auto max-w-4xl">
      Contamos con las herramientas necesarias para brindarte el apoyo en tu nueva web
    </h2>
    <p class="text-gray-400 mb-8 max-w-2xl">
      Ya sea en el plan emprendedor o corporativo. Tu negocio en línea con las mejores herramientas del mercado.
    </p>
    
    <a href="/diseno-desarrollo-web" class="inline-block px-7 py-2.5 bg-transparent border-2 border-white text-white rounded-lg font-semibold text-sm hover:bg-white hover:text-black transition-colors shadow-sm mb-20">
      Ver más
    </a>

    <!-- Floating Mobile Mockup -->
    <div class="relative w-full max-w-xs mx-auto animate-[bounce_4s_infinite]">
      <div class="absolute inset-0 bg-orange-500/20 blur-[60px] rounded-full"></div>
      
      <div class="relative z-10 w-[280px] h-[580px] mx-auto border-[6px] border-orange-500/30 rounded-[3rem] overflow-hidden bg-gradient-to-b from-[#1a0f0a] to-black p-4 shadow-2xl flex flex-col gap-4">
        <div class="w-full h-1/4 rounded-2xl bg-white/5 border border-white/10 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)]"></div>
        <div class="w-full h-1/4 rounded-2xl bg-white/5 border border-white/10 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)]"></div>
        <div class="w-full h-1/4 rounded-2xl bg-white/5 border border-white/10 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)]"></div>
        <div class="w-full h-1/4 rounded-2xl bg-white/5 border border-white/10 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)]"></div>
      </div>
    </div>
  </div>
</section>
