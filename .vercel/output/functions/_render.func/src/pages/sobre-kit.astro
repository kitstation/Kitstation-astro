---
import Layout from '../layouts/Layout.astro';
import HeaderKit from '../components/HeaderKit.astro';
---

<Layout title="Sobre KIT - KitStation" bodyClass="bg-white text-black">
  <HeaderKit />
  
  <main class="min-h-screen pt-[100px]">
    
    <!-- Top Section (White) -->
    <section class="py-20 px-6 md:px-12 max-w-7xl mx-auto flex flex-col items-center justify-center perspective-[1000px]">
      <!-- Glowing diamond image -->
      <div class="flow-item">
        <img src="/sobre-kit/img.diamante.jpg" alt="KitStation Motivación" id="diamond-img" class="w-full max-w-sm md:max-w-md object-contain transition-transform duration-200 ease-out" />
      </div>
    </section>

    <!-- Middle Section (Black) -->
    <section class="bg-black text-white py-24 px-6 md:px-12 w-full">
      <div class="max-w-4xl mx-auto text-center flex flex-col gap-8">
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight">¿Qué nos motiva?</h1>
        
        <p class="text-gray-300 text-lg md:text-xl leading-relaxed font-light">
          Nos frustran las soluciones lentas, el diseño por ego y las estrategias que no venden. Nos motiva construir productos o proyectos que vayan directo al grano: tecnología que funciona sin fricción y diseño que cumple un objetivo comercial.
        </p>

        <p class="text-white text-base md:text-lg font-medium italic mt-4">
          No estamos aquí para reinventar la rueda, estamos aquí para hacer que gire más rápido y en la dirección correcta.
        </p>
      </div>
    </section>

    <!-- Bottom Section (White) -->
    <section class="py-24 px-6 md:px-12 bg-white">
      <div class="max-w-7xl mx-auto flex flex-col items-center">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-16 text-center">¿Cómo lo hacemos?</h2>
        
        <!-- Flowchart / Diagram Area -->
        <div class="w-full max-w-5xl flex flex-col items-center relative mt-8 mb-12">
          
          <!-- Nivel 0 y 1: KitStation -->
          <div class="relative flex flex-col items-center flow-item">
            <img src="/sobre-kit/icono-kit-1.png" class="w-11 h-11 md:w-[53px] md:h-[53px] absolute -top-[1.8rem] md:-top-[2.25rem] z-20 drop-shadow-sm" alt="Icono Kit" />
            <img src="/sobre-kit/cuadro-1.png" class="w-52 md:w-[242px] z-10 relative mt-2 md:mt-3" alt="KitStation" />
          </div>

          <!-- Línea -->
          <div class="w-px h-7 bg-gray-300 flow-line-v"></div>

          <!-- Nivel 2: Análisis -->
          <img src="/sobre-kit/cuadro-2.png" class="w-[330px] md:w-[396px] flow-item" alt="Análisis de viabilidad y auditoría" />

          <!-- Línea -->
          <div class="w-px h-7 bg-gray-300 flow-line-v"></div>

          <!-- Nivel 3: Ejecución y Vías -->
          <div class="relative flex flex-col items-center flow-item">
            <img src="/sobre-kit/icono-vias.png" class="w-7 h-7 md:w-[35px] md:h-[35px] absolute -top-[0.85rem] md:-top-[1.1rem] z-20 drop-shadow-sm" alt="Icono bifurcación" />
            <img src="/sobre-kit/cuadro-3.png" class="w-[396px] md:w-[462px] z-10 relative" alt="Ejecución de precisión" />
          </div>

          <!-- Tronco inferior -->
          <div class="w-px h-7 bg-gray-300 flow-line-v"></div>

          <!-- Bifurcación -->
          <div class="w-full relative">
            <!-- Linea horizontal de conexión -->
            <div class="absolute top-0 left-1/4 right-1/4 h-px bg-gray-300 flow-line-h"></div>

            <!-- Contenedor Flex para las dos columnas -->
            <div class="flex justify-between w-full">
              
              <!-- Columna Izquierda -->
              <div class="w-1/2 flex flex-col items-center px-2">
                <!-- Línea vertical descendente -->
                <div class="w-px h-5 bg-gray-300 flow-line-v" style="transition-delay: 100ms;"></div>
                
                <!-- Pilar 3.1 -->
                <img src="/sobre-kit/cuadro-3.1.png" class="h-8 md:h-9 object-contain mb-1 flow-item" style="transition-delay: 200ms;" alt="Pilar de desarrollo y creación" />
                
                <!-- Línea vertical hacia el primer cuadro -->
                <div class="w-px h-5 bg-gray-300 flow-line-v" style="transition-delay: 300ms;"></div>
                
                <!-- Cuadro 3.1.1 -->
                <img src="/sobre-kit/cuadro-3.1.1.png" class="w-60 md:w-[286px] transition hover:scale-105 duration-300 cursor-pointer flow-item" style="transition-delay: 400ms;" alt="Desarrollo y codificación core" />
                
                <!-- Línea -->
                <div class="w-px h-6 bg-gray-300 flow-line-v" style="transition-delay: 100ms;"></div>
                
                <!-- Cuadro 3.1.2 -->
                <img src="/sobre-kit/cuadro-3.1.2.png" class="w-60 md:w-[286px] transition hover:scale-105 duration-300 cursor-pointer flow-item" style="transition-delay: 200ms;" alt="Información de avances (general)" />
                
                <!-- Línea -->
                <div class="w-px h-6 bg-gray-300 flow-line-v" style="transition-delay: 100ms;"></div>
                
                <!-- Cuadro 3.1.3 -->
                <img src="/sobre-kit/cuadro-3.1.3.png" class="w-[308px] md:w-[357px] transition hover:scale-105 duration-300 cursor-pointer flow-item" style="transition-delay: 200ms;" alt="Agente de información técnica" />
              </div>

              <!-- Columna Derecha -->
              <div class="w-1/2 flex flex-col items-center px-2">
                <!-- Línea vertical descendente -->
                <div class="w-px h-5 bg-gray-300 flow-line-v" style="transition-delay: 100ms;"></div>
                
                <!-- Pilar 3.2 -->
                <img src="/sobre-kit/cuadro-3.2.png" class="h-8 md:h-9 object-contain mb-1 flow-item" style="transition-delay: 200ms;" alt="Pilar de calidad y validación" />
                
                <!-- Línea vertical hacia el primer cuadro -->
                <div class="w-px h-5 bg-gray-300 flow-line-v" style="transition-delay: 300ms;"></div>
                
                <!-- Cuadro 3.2.1 -->
                <img src="/sobre-kit/cuadro-3.2.1.png" class="w-60 md:w-[286px] transition hover:scale-105 duration-300 cursor-pointer flow-item" style="transition-delay: 400ms;" alt="Aseguramiento de calidad (pruebas)" />
                
                <!-- Línea -->
                <div class="w-px h-6 bg-gray-300 flow-line-v" style="transition-delay: 100ms;"></div>
                
                <!-- Cuadro 3.2.2 -->
                <img src="/sobre-kit/cuadro-3.2.2.png" class="w-60 md:w-[286px] transition hover:scale-105 duration-300 cursor-pointer flow-item" style="transition-delay: 200ms;" alt="Validación y entrega al cliente" />
                
                <!-- Línea -->
                <div class="w-px h-6 bg-gray-300 flow-line-v" style="transition-delay: 100ms;"></div>
                
                <!-- Cuadro 3.2.3 -->
                <img src="/sobre-kit/cuadro-3.2.3.png" class="w-[308px] md:w-[357px] transition hover:scale-105 duration-300 cursor-pointer flow-item" style="transition-delay: 200ms;" alt="Agente de calidad y negocio" />
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Marquee Banner -->
    <section class="w-full bg-black h-[250px] flex items-center overflow-hidden relative">
      <div class="flex whitespace-nowrap animate-marquee">
        <!-- Grupo 1 -->
        <div class="flex shrink-0 items-center justify-around">
          <span class="text-white text-3xl md:text-[55px] font-bold px-10 tracking-wide">Diseño que convierte y arquitectura estructurada para resistir en producción.</span>
          <span class="text-white text-3xl md:text-[55px] font-bold px-10 tracking-wide">Diseño que convierte y arquitectura estructurada para resistir en producción.</span>
        </div>
        <!-- Grupo 2 (Copia exacta para el bucle) -->
        <div class="flex shrink-0 items-center justify-around" aria-hidden="true">
          <span class="text-white text-3xl md:text-[55px] font-bold px-10 tracking-wide">Diseño que convierte y arquitectura estructurada para resistir en producción.</span>
          <span class="text-white text-3xl md:text-[55px] font-bold px-10 tracking-wide">Diseño que convierte y arquitectura estructurada para resistir en producción.</span>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24 px-6 md:px-12 bg-[#F3F4F6] w-full flex flex-col items-center justify-center text-center">
      <div class="max-w-3xl mx-auto flex flex-col items-center gap-10">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900">
          ¿Hablamos de tu proyecto?
        </h2>
        
        <img src="/grupo-circulos/grupo-circulos.png" alt="Equipo KitStation" class="w-full max-w-sm md:max-w-md object-contain drop-shadow-sm" />
        
        <a href="/contacto" class="mt-4 px-8 py-3 rounded-xl border-2 border-black text-black font-semibold hover:bg-black hover:text-white transition-colors duration-300 block w-fit mx-auto">
          Contactar ahora
        </a>
      </div>
    </section>

  </main>

  <style>
    .flow-item {
      opacity: 0;
      transform: scale(0.85);
      transition: opacity 0.5s ease-out, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .flow-item.visible {
      opacity: 1;
      transform: scale(1);
    }

    .flow-line-v {
      transform-origin: top;
      transform: scaleY(0);
      transition: transform 0.4s ease-out;
    }
    .flow-line-v.visible {
      transform: scaleY(1);
    }

    .flow-line-h {
      transform-origin: center;
      transform: scaleX(0);
      transition: transform 0.5s ease-out;
    }
    .flow-line-h.visible {
      transform: scaleX(1);
    }

    @keyframes marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    .animate-marquee {
      animation: marquee 35s linear infinite;
      width: max-content;
    }
  </style>

  <script>
    const initFlowchartAnimations = () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          } else {
            entry.target.classList.remove('visible');
          }
        });
      }, {
        rootMargin: '0px 0px -15% 0px',
        threshold: 0.1
      });

      document.querySelectorAll('.flow-item, .flow-line-v, .flow-line-h').forEach(el => {
        observer.observe(el);
      });

      // Efecto Parallax para el diamante
      const diamond = document.getElementById('diamond-img');
      if (diamond) {
        document.addEventListener('mousemove', (e) => {
          // Calcula la posición del mouse relativa al centro de la pantalla
          const xAxis = (window.innerWidth / 2 - e.pageX) / 30;
          const yAxis = (window.innerHeight / 2 - e.pageY) / 30;
          
          // Aplica una traslación suave y una ligera rotación 3D
          diamond.style.transform = `translate(${xAxis}px, ${yAxis}px) rotateX(${yAxis/2}deg) rotateY(${-xAxis/2}deg)`;
        });
      }
    };

    // Ejecutar al cargar
    initFlowchartAnimations();
    // En caso de que se use ViewTransitions en Astro
    document.addEventListener('astro:page-load', initFlowchartAnimations);
  </script>
</Layout>
