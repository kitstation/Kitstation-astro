---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import "../styles/global.css";
---

<BaseLayout title="Nosotros | KitStation" description="Conoce más sobre KitStation, su enfoque, trayectoria y manera de construir soluciones digitales.">
  <Header />
  <main class="about-page">
    <section class="about-page__hero">
      <div class="container about-page__hero-grid">
        <h1>
          ¿Cómo nació<br />
          <span>Kitstation?</span>
        </h1>

        <div class="about-page__hero-copy">
          <p>
            Kitstation nació para conectar estrategia, diseño y tecnología en soluciones que generan resultados.
          </p>

          <p>
            Creamos herramientas para vender mejor, simplificar procesos y hacer crecer negocios.
          </p>
        </div>
      </div>
    </section>

    <section class="about-page__mission">
      <div class="container about-page__mission-grid">
        <div class="about-page__mission-visual">
          <img
            src="/images/about-boreal-blue.png"
            alt="Aurora boreal azul y celeste"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="about-page__mission-copy">
          <p class="about-page__eyebrow">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M7.657 6.247c.11-.33.576-.33.686 0l.645 1.937a2.89 2.89 0 0 0 1.829 1.828l1.936.645c.33.11.33.576 0 .686l-1.937.645a2.89 2.89 0 0 0-1.828 1.829l-.645 1.936a.361.361 0 0 1-.686 0l-.645-1.937a2.89 2.89 0 0 0-1.828-1.828l-1.937-.645a.361.361 0 0 1 0-.686l1.937-.645a2.89 2.89 0 0 0 1.828-1.828zM3.794 1.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387A1.73 1.73 0 0 0 4.593 5.69l-.387 1.162a.217.217 0 0 1-.412 0L3.407 5.69A1.73 1.73 0 0 0 2.31 4.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387A1.73 1.73 0 0 0 3.407 2.31zM10.863.099a.145.145 0 0 1 .274 0l.258.774c.115.346.386.617.732.732l.774.258a.145.145 0 0 1 0 .274l-.774.258a1.16 1.16 0 0 0-.732.732l-.258.774a.145.145 0 0 1-.274 0l-.258-.774a1.16 1.16 0 0 0-.732-.732L9.1 2.137a.145.145 0 0 1 0-.274l.774-.258c.346-.115.617-.386.732-.732z"/>
            </svg>
            <span>Misión y visión</span>
          </p>

          <article>
            <h2>Nuestra misión</h2>
            <p>
              Ayudar a las empresas a vender mejor y operar de forma más eficiente mediante estrategia,
              diseño, software, automatización e inteligencia artificial aplicada.
            </p>
          </article>

          <article>
            <h2>Nuestra visión</h2>
            <p>
              Convertirnos en un socio tecnológico referente para empresas que buscan crecer, digitalizar
              sus procesos y aprovechar la tecnología con resultados reales.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>

<style>
  .about-page {
    background: #fff;
    color: #000;
    min-height: 100vh;
  }

  .about-page__hero {
    min-height: auto;
    display: flex;
    align-items: flex-start;
    padding: 96px 0 96px;
  }

  .about-page__hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.8fr);
    gap: clamp(64px, 10vw, 170px);
    align-items: center;
  }

  .about-page__hero h1 {
    margin: 0;
    color: #2b2d33;
    font-size: clamp(3.1rem, 4.8vw, 5.3rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.065em;
    text-align: center;
    text-transform: none;
  }

  .about-page__hero h1 span {
    color: #1b70ff;
  }

  .about-page__hero-copy {
    max-width: 650px;
  }

  .about-page__hero-copy p {
    margin: 0;
    color: #050505;
    font-size: clamp(0.98rem, 1.12vw, 1.18rem);
    font-weight: 400;
    line-height: 1.58;
  }

  .about-page__hero-copy p + p {
    margin-top: 24px;
  }

  .about-page__mission {
    padding: 32px 0 130px;
  }

  .about-page__mission-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.85fr);
    gap: clamp(56px, 8vw, 120px);
    align-items: center;
  }

  .about-page__mission-visual {
    position: relative;
    min-height: clamp(420px, 45vw, 620px);
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(27, 112, 255, 0.18);
    background: #071126;
    box-shadow: 0 28px 70px rgba(27, 112, 255, 0.16);
  }

  .about-page__mission-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.24));
    pointer-events: none;
  }

  .about-page__mission-visual img {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    object-fit: cover;
  }

  .about-page__mission-copy {
    max-width: 690px;
  }

  .about-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: max-content;
    margin: 0 0 72px;
    padding: 10px 18px;
    border: 1px solid rgba(27, 112, 255, 0.18);
    border-radius: 999px;
    color: #1b70ff;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .about-page__mission-copy article + article {
    margin-top: 48px;
  }

  .about-page__mission-copy h2 {
    margin: 0 0 18px;
    color: #101216;
    font-size: clamp(2.4rem, 4vw, 4.2rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.065em;
  }

  .about-page__mission-copy p:not(.about-page__eyebrow) {
    margin: 0;
    color: #17191f;
    font-size: clamp(1rem, 1.15vw, 1.24rem);
    font-weight: 400;
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .about-page__hero {
      min-height: auto;
      padding: 64px 0 84px;
      align-items: flex-start;
    }

    .about-page__hero-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .about-page__hero h1 {
      font-size: clamp(2.7rem, 11.5vw, 3.6rem);
      letter-spacing: -0.06em;
    }

    .about-page__hero-copy p {
      font-size: 0.95rem;
      line-height: 1.62;
    }

    .about-page__mission {
      padding: 12px 0 84px;
    }

    .about-page__mission-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .about-page__mission-visual {
      min-height: 320px;
      border-radius: 14px;
    }

    .about-page__eyebrow {
      margin-bottom: 34px;
      font-size: 0.86rem;
    }

    .about-page__mission-copy article + article {
      margin-top: 34px;
    }

    .about-page__mission-copy h2 {
      font-size: clamp(2.15rem, 12vw, 3.1rem);
    }

    .about-page__mission-copy p:not(.about-page__eyebrow) {
      font-size: 0.96rem;
      line-height: 1.6;
    }
  }
</style>
